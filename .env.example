# LibraryMaster Environment Configuration
# Copy this file to .env and fill in the values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Using MySQL as per project setup
MYSQL_DB_NAME=library_db
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=your_password_here
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_TEST_DB=library_test_db

# Email Configuration (Gmail SMTP)
# Get your app password from: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Alternative: Using other email providers
# For Outlook/Microsoft 365:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@outlook.com
# EMAIL_HOST_PASSWORD=your_password

# For development/testing: console backend (prints emails to console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For production testing: file backend (saves emails to files)
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=/path/to/email-logs

# Site Configuration
SITE_NAME=LibraryMaster
SITE_URL=http://localhost:8000
